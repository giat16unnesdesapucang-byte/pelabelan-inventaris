<Window x:Class="DesktopAdmin.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pengaturan PIN Petugas Mobile" Height="420" Width="480"
        WindowStartupLocation="CenterOwner" Background="#F9FAFB" FontFamily="Segoe UI"
        ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="🔒 Keamanan &amp; PIN Petugas" FontSize="20" FontWeight="Bold" Foreground="#111827"/>
            <TextBlock Text="PIN ini digunakan untuk aktivasi 1x smartphone petugas sebelum menginstal aplikasi mobile scanner." FontSize="12" Foreground="#6B7280" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Body Form -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,16">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="PIN Petugas Aktif Saat Ini" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" Margin="0,0,0,4"/>
                <TextBlock x:Name="TxtCurrentPinDisplay" Text="Memuat PIN..." FontSize="16" FontWeight="Bold" Foreground="#047857" Margin="0,0,0,16"/>

                <TextBlock Text="Ubah ke PIN Baru (4 - 8 Digit Angka) *" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtNewPin" Padding="10" FontSize="15" FontWeight="Bold" BorderBrush="#D1D5DB" Margin="0,0,0,14" MaxLength="8"/>

                <TextBlock Text="Konfirmasi PIN Baru *" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtConfirmPin" Padding="10" FontSize="15" FontWeight="Bold" BorderBrush="#D1D5DB" Margin="0,0,0,8" MaxLength="8"/>

                <TextBlock Text="💡 Rekomendasi: Gunakan PIN 6 angka yang mudah diingat oleh perangkat desa." FontSize="11" Foreground="#9CA3AF" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Footer Actions & Status -->
        <Grid Grid.Row="2">
            <TextBlock x:Name="TxtSavingStatus" Text="Menyimpan PIN ke Supabase..." VerticalAlignment="Center" Foreground="#2563EB" FontWeight="SemiBold" Visibility="Collapsed"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Batal" Padding="16,9" Background="Transparent" Foreground="#4B5563" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand" Click="BtnCancel_Click"/>
                <Button x:Name="BtnSavePin" Content="💾 Simpan PIN Baru" Padding="18,9" Background="#059669" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" Click="BtnSavePin_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
