<Window x:Class="DesktopAdmin.PrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cetak Label QR (Batch Print)" Height="700" Width="850"
        WindowStartupLocation="CenterOwner" Background="#F3F4F6">
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Print" Executed="BtnPrint_Click" />
    </Window.CommandBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <Border Grid.Row="0" Background="White" Padding="20" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
            <Grid>
                <TextBlock Text="Pratinjau Cetak Stiker QR Code" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Content="🖨️ Cetak Sekarang" HorizontalAlignment="Right" Background="#10B981" Foreground="White" Padding="20,10" BorderThickness="0" Cursor="Hand" FontWeight="Bold" Command="ApplicationCommands.Print"/>
            </Grid>
        </Border>

        <!-- Document Viewer for Preview -->
        <DocumentViewer x:Name="DocViewer" Grid.Row="1" Background="#F3F4F6"/>
    </Grid>
</Window>
