<Window x:Class="DesktopAdmin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inventaris Aset Desa - Admin Panel" Height="600" Width="900"
        Background="#FAFAFA" FontFamily="Segoe UI">
    <Window.Resources>
        <!-- Styles -->
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#4B5563"/>
            <Setter Property="Padding" Value="10,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style x:Key="SidebarButtonActive" TargetType="Button" BasedOn="{StaticResource SidebarButton}">
            <Setter Property="Background" Value="#ECFDF5"/>
            <Setter Property="Foreground" Value="#059669"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0">
            <StackPanel Margin="20">
                <TextBlock Text="BALAI DESA PUCANG" FontWeight="Bold" FontSize="12" Foreground="#6B7280" Margin="0,0,0,4"/>
                <TextBlock Text="Admin Panel" FontWeight="SemiBold" FontSize="20" Margin="0,0,0,30"/>
                
                <Button x:Name="BtnNavDashboard" Content="Dashboard" Style="{StaticResource SidebarButtonActive}" Click="BtnNavDashboard_Click"/>
                <Button x:Name="BtnNavAssets" Content="Data Aset" Style="{StaticResource SidebarButton}" Click="BtnNavAssets_Click"/>
                <Button x:Name="BtnNavCategories" Content="Kategori" Style="{StaticResource SidebarButton}" Click="BtnNavCategories_Click"/>
                <Button x:Name="BtnNavLoans" Content="Sirkulasi Peminjaman" Style="{StaticResource SidebarButton}" Click="BtnNavLoans_Click"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Column="1" Margin="30">
            <!-- Page 0: Dashboard -->
            <Grid x:Name="PageDashboard" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Beranda Command Center" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,20"/>

                <!-- Top: Stats Cards -->
                <UniformGrid Grid.Row="1" Columns="4" Rows="1" VerticalAlignment="Top" Margin="0,0,0,20">
                    <!-- Total Aset -->
                    <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10" Margin="0,0,10,0" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Total Aset Keseluruhan" FontSize="13" Foreground="#6B7280" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtTotalAset" Text="0" FontSize="36" FontWeight="Bold" Margin="0,5,0,0" Foreground="#111827"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Aset Tersedia -->
                    <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="10" Margin="5,0,5,0" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Aset Tersedia" FontSize="13" Foreground="#065F46" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtAsetTersedia" Text="0" FontSize="36" FontWeight="Bold" Margin="0,5,0,0" Foreground="#047857"/>
                        </StackPanel>
                    </Border>

                    <!-- Aset Dipinjam -->
                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="10" Margin="5,0,5,0" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Sedang Dipinjam" FontSize="13" Foreground="#1E40AF" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtAsetDipinjam" Text="0" FontSize="36" FontWeight="Bold" Margin="0,5,0,0" Foreground="#1D4ED8"/>
                        </StackPanel>
                    </Border>

                    <!-- Aset Rusak -->
                    <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="10" Margin="10,0,0,0" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Butuh Perbaikan" FontSize="13" Foreground="#991B1B" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtAsetRusak" Text="0" FontSize="36" FontWeight="Bold" Margin="0,5,0,0" Foreground="#B91C1C"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Bottom: Lists and Actions -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Recent Activity -->
                    <Border Grid.Column="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10" Margin="0,0,10,0" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Aktivitas Terakhir" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15"/>
                            <ListView Grid.Row="1" x:Name="ListRecentActivities" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#F3F4F6" BorderThickness="0,0,0,1" Padding="10,12" Margin="0,0,0,5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="80"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding AssetCodeProxy}" FontWeight="SemiBold" FontSize="14" Foreground="#111827"/>
                                                    <TextBlock Text="{Binding BorrowerName}" FontSize="12" Foreground="#6B7280" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding BorrowDateString}" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center"/>
                                                <Border Grid.Column="2" CornerRadius="4" Padding="5,2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#EFF6FF"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Selesai">
                                                                    <Setter Property="Background" Value="#ECFDF5"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Aktif">
                                                                    <Setter Property="Background" Value="#EFF6FF"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Terlambat">
                                                                    <Setter Property="Background" Value="#FEF2F2"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#1D4ED8"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Selesai">
                                                                        <Setter Property="Foreground" Value="#059669"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Aktif">
                                                                        <Setter Property="Foreground" Value="#1D4ED8"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Terlambat">
                                                                        <Setter Property="Foreground" Value="#DC2626"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                            </ListView>
                        </Grid>
                    </Border>

                    <!-- Right: Overdue Alerts & Quick Actions -->
                    <Grid Grid.Column="1" Margin="10,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Alerts -->
                        <Border Grid.Row="0" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Peringatan Keterlambatan" FontSize="16" FontWeight="SemiBold" Foreground="#991B1B" Margin="0,0,0,15"/>
                                <ListView Grid.Row="1" x:Name="ListOverdueLoans" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="White" CornerRadius="6" Padding="10" Margin="0,0,0,8" BorderBrush="#FCA5A5" BorderThickness="1">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding AssetCodeProxy}" FontWeight="SemiBold" FontSize="13" Foreground="#991B1B"/>
                                                    <TextBlock Text="{Binding BorrowerName}" FontSize="12" Foreground="#B91C1C" Margin="0,2,0,4"/>
                                                    <TextBlock Text="{Binding ExpectedReturnString, StringFormat='Batas: {0}'}" FontSize="11" Foreground="#DC2626" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                </ListView>
                            </Grid>
                        </Border>

                        <!-- Quick Actions -->
                        <Border Grid.Row="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Aksi Cepat" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,15"/>
                                <Button Content="+ Tambah Aset Baru" Background="#10B981" Foreground="White" Padding="10,12" BorderThickness="0" Cursor="Hand" Click="BtnAddAsset_Click" Margin="0,0,0,10" FontWeight="SemiBold"/>
                                <Button Content="Cetak Barcode" Background="#3B82F6" Foreground="White" Padding="10,12" BorderThickness="0" Cursor="Hand" Click="BtnPrintBatch_Click" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Page 1: Data Aset -->
            <Grid x:Name="PageAssets" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <TextBlock Grid.Row="0" Text="Data Aset Utama" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,20"/>

                <!-- Toolbar -->
                <Grid Grid.Row="1" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Content="+ Tambah Aset" Background="#10B981" Foreground="White" Padding="12,8" BorderThickness="0" Cursor="Hand" Click="BtnAddAsset_Click"/>
                        <Button x:Name="BtnEditAsset" Content="Ubah" Margin="10,0,0,0" Background="#F59E0B" Foreground="White" Padding="12,8" BorderThickness="0" Cursor="Hand" Click="BtnEditAsset_Click"/>
                        <Button x:Name="BtnDeleteAsset" Content="Hapus" Margin="10,0,0,0" Background="#EF4444" Foreground="White" Padding="12,8" BorderThickness="0" Cursor="Hand" Click="BtnDeleteAsset_Click"/>
                        <Button x:Name="BtnViewHistory" Content="Lihat Riwayat" Margin="10,0,0,0" Background="#6B7280" Foreground="White" Padding="12,8" BorderThickness="0" Cursor="Hand" Click="BtnViewHistory_Click"/>
                        <Button Content="Cetak Batch QR" Margin="10,0,0,0" Background="#3B82F6" Foreground="White" Padding="12,8" BorderThickness="0" Cursor="Hand" Click="BtnPrintBatch_Click"/>
                        <Button x:Name="BtnExportAssets" Content="📊 Export Laporan Excel (.xlsx)" Margin="10,0,0,0" Background="#059669" Foreground="White" Padding="12,8" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" Click="BtnExportAssets_Click"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <TextBlock Text="Cari:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="TxtSearchAsset" Width="200" Padding="8" BorderBrush="#D1D5DB" TextChanged="TxtSearchAsset_TextChanged"/>
                    </StackPanel>
                </Grid>

                <!-- DataGrid -->
                <DataGrid x:Name="AssetsGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Extended"
                          Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                          RowBackground="White" AlternatingRowBackground="#F9FAFB"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="SKU / ID Aset" Binding="{Binding AssetCode}" Width="120"/>
                        <DataGridTextColumn Header="Nama Aset" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Lokasi" Binding="{Binding Location}" Width="130"/>
                        <DataGridTextColumn Header="Sumber Dana" Binding="{Binding FundingSourceDisplay}" Width="130"/>
                        <DataGridTextColumn Header="Nilai Aset" Binding="{Binding PriceDisplay}" Width="120"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding AvailabilityStatus}" Width="90"/>
                        <DataGridTextColumn Header="Kondisi" Binding="{Binding Condition}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Dual Preview Area: QR Label & Physical Photo -->
                <Grid Grid.Row="3" Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Card 1: QR Preview -->
                    <Border Grid.Column="0" Margin="0,0,10,0" Padding="15" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Width="100" Height="100">
                                <Image x:Name="QrPreviewImage" Stretch="Uniform" Margin="4"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="15,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Preview QR Label" FontWeight="Bold" FontSize="15" Foreground="#1F2937" Margin="0,0,0,4"/>
                                <TextBlock x:Name="QrPreviewText" Text="Pilih aset di tabel untuk melihat QR Code." Foreground="#6B7280" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Card 2: Photo Preview -->
                    <Border Grid.Column="1" Margin="10,0,0,0" Padding="15" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Width="100" Height="100" ClipToBounds="True">
                                <Grid>
                                    <TextBlock x:Name="PhotoPreviewPlaceholder" Text="📷&#x0a;No Foto" TextAlignment="Center" VerticalAlignment="Center" Foreground="#9CA3AF" FontSize="12"/>
                                    <Image x:Name="PhotoPreviewImage" Stretch="UniformToFill" Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="15,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Foto Fisik Aset" FontWeight="Bold" FontSize="15" Foreground="#1F2937" Margin="0,0,0,4"/>
                                <TextBlock x:Name="PhotoPreviewText" Text="Pilih aset di tabel untuk melihat foto." Foreground="#6B7280" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- Page 2: Sirkulasi Peminjaman -->
            <Grid x:Name="PageLoans" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Header -->
                <TextBlock Grid.Row="0" Text="Data Sirkulasi Peminjaman" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,15"/>

                <!-- Toolbar -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
                    <Button Content="📊 Export Laporan Peminjaman (.xlsx)" Background="#059669" Foreground="White" Padding="12,8" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" Click="BtnExportLoans_Click"/>
                </StackPanel>
                
                <!-- DataGrid -->
                <DataGrid x:Name="LoansGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False"
                          Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                          RowBackground="White" AlternatingRowBackground="#F9FAFB"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Peminjam" Binding="{Binding BorrowerName}" Width="*"/>
                        <DataGridTextColumn Header="NIK" Binding="{Binding BorrowerNik}" Width="150"/>
                        <DataGridTextColumn Header="ID Aset" Binding="{Binding AssetCodeProxy}" Width="120"/>
                        <DataGridTextColumn Header="Tgl Pinjam" Binding="{Binding BorrowDateString}" Width="150"/>
                        <DataGridTextColumn Header="Tenggat" Binding="{Binding ExpectedReturnString}" Width="150"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
            
            <!-- Page 3: Kategori -->
            <Grid x:Name="PageCategories" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <TextBlock Grid.Row="0" Text="Manajemen Kategori" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,20"/>

                <!-- Toolbar -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
                    <Button Content="+ Tambah Kategori" Background="#10B981" Foreground="White" Padding="12,8" BorderThickness="0" Cursor="Hand" Click="BtnAddCategory_Click"/>
                    <Button x:Name="BtnEditCategory" Content="Ubah" Margin="10,0,0,0" Background="#F59E0B" Foreground="White" Padding="12,8" BorderThickness="0" Cursor="Hand" Click="BtnEditCategory_Click"/>
                    <Button x:Name="BtnDeleteCategory" Content="Hapus" Margin="10,0,0,0" Background="#EF4444" Foreground="White" Padding="12,8" BorderThickness="0" Cursor="Hand" Click="BtnDeleteCategory_Click"/>
                </StackPanel>

                <!-- DataGrid -->
                <DataGrid x:Name="CategoriesGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False"
                          Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                          RowBackground="White" AlternatingRowBackground="#F9FAFB"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nama Kategori" Binding="{Binding Name}" Width="200"/>
                        <DataGridTextColumn Header="Deskripsi" Binding="{Binding Description}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </Grid>
</Window>
