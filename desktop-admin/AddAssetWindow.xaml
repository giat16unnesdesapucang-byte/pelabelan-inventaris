<Window x:Class="DesktopAdmin.AddAssetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tambah Aset Baru" Height="680" Width="760"
        WindowStartupLocation="CenterOwner" Background="#F9FAFB" FontFamily="Segoe UI"
        ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock x:Name="TxtHeaderTitle" Grid.Row="0" Text="Tambah Data Aset" FontSize="22" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,16"/>

        <!-- Form 2-Column Body -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Column: Asset Info Fields (Scrollable) -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Nama Aset *" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtName" Padding="8" Margin="0,0,0,12" BorderBrush="#D1D5DB" FontSize="13"/>

                    <TextBlock Text="Kategori Aset" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbCategory" Padding="7" Margin="0,0,0,12" DisplayMemberPath="Name" SelectedValuePath="Id" FontSize="13" SelectionChanged="CmbCategory_SelectionChanged"/>

                    <!-- Grid: Sumber Dana & Tanggal Beli -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Sumber Dana" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbFundingSource" IsEditable="True" Padding="6" FontSize="12">
                                <ComboBoxItem Content="Dana Desa (DDS)"/>
                                <ComboBoxItem Content="Alokasi Dana Desa (ADD)"/>
                                <ComboBoxItem Content="Pendapatan Asli Desa (PADes)"/>
                                <ComboBoxItem Content="Bantuan Keuangan Provinsi"/>
                                <ComboBoxItem Content="Bantuan Keuangan Kab"/>
                                <ComboBoxItem Content="Hibah / Swadaya"/>
                                <ComboBoxItem Content="Lainnya"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Tgl Perolehan" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,4"/>
                            <DatePicker x:Name="DpPurchaseDate" Padding="4" FontSize="12" SelectedDateChanged="DpPurchaseDate_SelectedDateChanged"/>
                        </StackPanel>
                    </Grid>

                    <!-- Kode SKU dengan Auto-Generate Button -->
                    <TextBlock Text="Kode SKU / ID Aset *" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtAssetCode" Grid.Column="0" Padding="8" BorderBrush="#D1D5DB" FontSize="13" FontWeight="SemiBold"/>
                        <Button x:Name="BtnAutoGenerateCode" Grid.Column="2" Content="⚡ Buat Kode Otomatis" Background="#059669" Foreground="White" Padding="12,6" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" Click="BtnAutoGenerateCode_Click"/>
                    </Grid>
                    <TextBlock Text="💡 Format standar: PCG-[Kategori]-[Tahun]-[NoUrut]. Tetap dapat diubah manual." FontSize="11" Foreground="#6B7280" Margin="0,0,0,12"/>

                    <TextBlock Text="Lokasi Penyimpanan" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtLocation" Padding="8" Margin="0,0,0,12" BorderBrush="#D1D5DB" FontSize="13"/>

                    <!-- Grid: Nilai Barang & Kondisi -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Nilai Aset (Rp)" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtPrice" Padding="8" BorderBrush="#D1D5DB" FontSize="13" Text="0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Kondisi Fisik" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbCondition" Padding="7" FontSize="13">
                                <ComboBoxItem Content="Baik" IsSelected="True"/>
                                <ComboBoxItem Content="Rusak Ringan"/>
                                <ComboBoxItem Content="Rusak Berat"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Keterangan / Deskripsi Spesifikasi" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtDescription" Padding="8" Margin="0,0,0,8" BorderBrush="#D1D5DB" FontSize="12" AcceptsReturn="True" Height="60" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Right Column: Photo Upload & Preview -->
            <Border Grid.Column="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Foto Fisik Aset" FontWeight="SemiBold" FontSize="14" Foreground="#374151" Margin="0,0,0,10"/>

                    <!-- Photo Preview Box -->
                    <Border Grid.Row="1" Background="#F3F4F6" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="8" ClipToBounds="True" Margin="0,0,0,12" Height="190">
                        <Grid>
                            <StackPanel x:Name="PhotoEmptyPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="📷" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                <TextBlock Text="Belum ada foto dipilih" FontSize="12" Foreground="#9CA3AF" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <Image x:Name="ImgAssetPreview" Stretch="UniformToFill" Visibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <!-- Photo Action Buttons -->
                    <StackPanel Grid.Row="2">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnSelectPhoto" Grid.Column="0" Content="📁 Pilih Foto..." Padding="10,8" Background="#3B82F6" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" Click="BtnSelectPhoto_Click" Margin="0,0,6,0"/>
                            <Button x:Name="BtnRemovePhoto" Grid.Column="1" Content="✕ Hapus" Padding="10,8" Background="#F3F4F6" Foreground="#EF4444" BorderBrush="#E5E7EB" BorderThickness="1" Cursor="Hand" Click="BtnRemovePhoto_Click" ToolTip="Hapus Foto"/>
                        </Grid>
                        <TextBlock x:Name="TxtPhotoStatus" Text="Format: JPG, PNG, WEBP (Maks 5MB)" FontSize="11" Foreground="#9CA3AF" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer Buttons & Progress -->
        <Grid Grid.Row="2">
            <TextBlock x:Name="TxtSavingStatus" Text="Mengunggah foto &amp; menyimpan aset..." VerticalAlignment="Center" Foreground="#2563EB" FontWeight="SemiBold" Visibility="Collapsed"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Batal" Padding="18,10" Background="Transparent" Foreground="#4B5563" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand" Click="BtnCancel_Click"/>
                <Button x:Name="BtnSave" Content="Simpan Aset" Padding="20,10" Background="#10B981" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" Click="BtnSave_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
