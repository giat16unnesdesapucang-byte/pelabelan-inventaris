<Window x:Class="DesktopAdmin.CategoryFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tambah Kategori Baru" Height="300" Width="400"
        Icon="app.ico"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#FAFAFA" FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Nama Kategori" Grid.Row="0" FontWeight="SemiBold" Margin="0,0,0,5"/>
        <TextBox x:Name="TxtName" Grid.Row="1" Padding="8" BorderBrush="#D1D5DB" BorderThickness="1" Margin="0,0,0,15"/>

        <TextBlock Text="Deskripsi (Opsional)" Grid.Row="2" FontWeight="SemiBold" Margin="0,0,0,5"/>
        <TextBox x:Name="TxtDescription" Grid.Row="3" Padding="8" Height="60" TextWrapping="Wrap" AcceptsReturn="True" BorderBrush="#D1D5DB" BorderThickness="1" Margin="0,0,0,15"/>

        <TextBlock x:Name="TxtError" Grid.Row="4" Foreground="#DC2626" Visibility="Collapsed" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Batal" Width="80" Padding="8" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" Cursor="Hand" Click="BtnCancel_Click"/>
            <Button Content="Simpan" Width="80" Padding="8" Background="#10B981" Foreground="White" BorderThickness="0" Margin="10,0,0,0" Cursor="Hand" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
