<Window x:Class="DesktopAdmin.AddAssetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tambah Aset Baru" Height="580" Width="680"
        WindowStartupLocation="CenterOwner" Background="#F9FAFB" FontFamily="Segoe UI"
        ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock x:Name="TxtHeaderTitle" Grid.Row="0" Text="Tambah Data Aset" FontSize="22" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,20"/>

        <!-- Form 2-Column Body -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Column: Asset Info Fields -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Nama Aset *" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtName" Padding="9" Margin="0,0,0,14" BorderBrush="#D1D5DB" FontSize="13"/>

                    <TextBlock Text="Kode SKU Aset *" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtAssetCode" Padding="9" Margin="0,0,0,14" BorderBrush="#D1D5DB" Text="INV-2026-" FontSize="13"/>

                    <TextBlock Text="Kategori Aset" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,5"/>
                    <ComboBox x:Name="CmbCategory" Padding="8" Margin="0,0,0,14" DisplayMemberPath="Name" SelectedValuePath="Id" FontSize="13"/>

                    <TextBlock Text="Lokasi Penyimpanan" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtLocation" Padding="9" Margin="0,0,0,14" BorderBrush="#D1D5DB" FontSize="13"/>

                    <TextBlock Text="Kondisi Fisik" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,5"/>
                    <ComboBox x:Name="CmbCondition" Padding="8" Margin="0,0,0,5" FontSize="13">
                        <ComboBoxItem Content="Baik" IsSelected="True"/>
                        <ComboBoxItem Content="Rusak Ringan"/>
                        <ComboBoxItem Content="Rusak Berat"/>
                    </ComboBox>
                </StackPanel>
            </ScrollViewer>

            <!-- Right Column: Photo Upload & Preview -->
            <Border Grid.Column="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Foto Fisik Aset" FontWeight="SemiBold" FontSize="14" Foreground="#374151" Margin="0,0,0,10"/>

                    <!-- Photo Preview Box -->
                    <Border Grid.Row="1" Background="#F3F4F6" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="8" ClipToBounds="True" Margin="0,0,0,12" Height="190">
                        <Grid>
                            <StackPanel x:Name="PhotoEmptyPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="📷" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                <TextBlock Text="Belum ada foto dipilih" FontSize="12" Foreground="#9CA3AF" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <Image x:Name="ImgAssetPreview" Stretch="UniformToFill" Visibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <!-- Photo Action Buttons -->
                    <StackPanel Grid.Row="2">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnSelectPhoto" Grid.Column="0" Content="📁 Pilih Foto..." Padding="10,8" Background="#3B82F6" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" Click="BtnSelectPhoto_Click" Margin="0,0,6,0"/>
                            <Button x:Name="BtnRemovePhoto" Grid.Column="1" Content="✕ Hapus" Padding="10,8" Background="#F3F4F6" Foreground="#EF4444" BorderBrush="#E5E7EB" BorderThickness="1" Cursor="Hand" Click="BtnRemovePhoto_Click" ToolTip="Hapus Foto"/>
                        </Grid>
                        <TextBlock x:Name="TxtPhotoStatus" Text="Format: JPG, PNG, WEBP (Maks 5MB)" FontSize="11" Foreground="#9CA3AF" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer Buttons & Progress -->
        <Grid Grid.Row="2">
            <TextBlock x:Name="TxtSavingStatus" Text="Mengunggah foto &amp; menyimpan aset..." VerticalAlignment="Center" Foreground="#2563EB" FontWeight="SemiBold" Visibility="Collapsed"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Batal" Padding="18,10" Background="Transparent" Foreground="#4B5563" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand" Click="BtnCancel_Click"/>
                <Button x:Name="BtnSave" Content="Simpan Aset" Padding="20,10" Background="#10B981" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" Click="BtnSave_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
